{
  "$defs": {
    "OutcomeAssessment": {
      "additionalProperties": false,
      "properties": {
        "probability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability"
        },
        "probability_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability Label"
        },
        "tier": {
          "$ref": "#/$defs/TierValue"
        },
        "tier_reason": {
          "$ref": "#/$defs/TierReason"
        },
        "measurement_quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_references": {
          "items": {
            "type": "string"
          },
          "title": "Evidence References",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "recommended_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecommendedAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Day"
        }
      },
      "required": [
        "tier",
        "tier_reason",
        "explanation"
      ],
      "title": "OutcomeAssessment",
      "type": "object"
    },
    "QualityStatus": {
      "description": "Schema v0.3.0 adds UNKNOWN (additive, non-breaking - OK/DEGRADED/FAILED/\nNOT_TAKEN are unchanged): a scan whose documented protocol metadata (e.g.\non-axis acquisition) was never recorded, so quality cannot be established\neither way - distinct from NOT_TAKEN (no scan attempted at all). See\nmonitoring/measurement_quality.py for the one sourced rule that can derive\nthis automatically.",
      "enum": [
        "ok",
        "degraded",
        "failed",
        "not_taken",
        "unknown"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "RecommendedAction": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "default": "suggested",
          "title": "Status",
          "type": "string"
        },
        "ground_review_required": {
          "default": false,
          "title": "Ground Review Required",
          "type": "boolean"
        },
        "follow_up_day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Follow Up Day"
        },
        "follow_up_rule": {
          "title": "Follow Up Rule",
          "type": "string"
        },
        "quality_repeat_required": {
          "default": false,
          "title": "Quality Repeat Required",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "outcome",
        "text",
        "follow_up_rule"
      ],
      "title": "RecommendedAction",
      "type": "object"
    },
    "TierReason": {
      "description": "Schema v0.4.0 (additive): WHY a tier was assigned, kept structurally\nseparate from the tier itself (section 4, Unified Prompt 8-9) - a\nmeasurement-quality Repeat is not evidence a physiological event was\ndetected, and must never be read as one just because the tier is Repeat.",
      "enum": [
        "red_flag_symptom",
        "measurement_quality",
        "insufficient_evidence_for_probability",
        "probability_threshold",
        "persistent_serious_evidence"
      ],
      "title": "TierReason",
      "type": "string"
    },
    "TierValue": {
      "enum": [
        "monitor",
        "repeat",
        "consult",
        "urgent",
        "unresolved"
      ],
      "title": "TierValue",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "astronaut_id": {
      "title": "Astronaut Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "as_of_day": {
      "title": "As Of Day",
      "type": "integer"
    },
    "sans": {
      "$ref": "#/$defs/OutcomeAssessment"
    },
    "venous": {
      "$ref": "#/$defs/OutcomeAssessment"
    }
  },
  "required": [
    "astronaut_id",
    "as_of_day",
    "sans",
    "venous"
  ],
  "title": "AssessmentResult",
  "type": "object"
}
